SELECT AVG(price) AS Average_Order_Price
FROM Order_Details;





SELECT
    product_name,
    SUM(price * quantity) AS Total_Sales
FROM Order_Details
GROUP BY product_name;





SELECT
    product_name,
    SUM(price * quantity) AS Total_Sales
FROM Order_Details
GROUP BY product_name
ORDER BY Total_Sales DESC;
