SELECT Customers.customer_name, Orders.order_name
FROM Customers
INNER JOIN Orders
ON Customers.customer_id = Orders.customer_id

SELECT Customers.customer_name, Orders.order_name
FROM Customers
LEFT JOIN Orders
ON Customers.customer_id = Orders.customer_id;
