CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    product_name VARCHAR(50),
    quantity INT,
    price DECIMAL(10,2)
);
INSERT INTO orders VALUES
(1, 'Apple Juice', 3, 150),
(2, 'Banana Chips', 1, 80),
(3, 'Avocado', 5, 300),
(4, 'Orange Juice', 2, 450),
(5, 'Almonds', 4, 600);

SELECT * 
FROM orders
WHERE quantity > 2;

SELECT * 
FROM orders
WHERE price BETWEEN 100 AND 500;

SELECT * 
FROM orders
WHERE product_name LIKE 'A%';

SELECT * 
FROM orders
ORDER BY quantity DESC;

CREATE TABLE events (
    event_id INT PRIMARY KEY,
    event_name VARCHAR(50),
    event_date DATE
);

INSERT INTO events VALUES
(1, 'Music Show', '2026-05-20'),
(2, 'Tech Fest', '2026-06-10');

SELECT CONCAT(event_name, ' - ', event_date) AS event_details
FROM events;
